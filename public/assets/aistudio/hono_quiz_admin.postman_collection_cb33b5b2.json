{
  "info": {
    "name": "hono quiz admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Production-ready Postman Collection for QuizPlatform microservices running on Cloudflare Workers (Hono) connected to Hostinger MySQL (u427015050_drizzle) via Drizzle ORM and Cloudflare Hyperdrive.\n\nIncludes complete CRUD endpoints for Categories, Exams, Subjects, Topics, Quizzes, Questions, Attempts, Offline Sync, Payments, Auth, and Analytics."
  },
