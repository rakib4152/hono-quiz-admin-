// Prisma Schema for Scalable Quiz Platform
// Engine: Hostinger MySQL 8.0.x InnoDB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(cuid()) @db.VarChar(30)
  name         String?  @db.VarChar(191)
  email        String?  @unique @db.VarChar(191)
  passwordHash String?  @db.VarChar(255)
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  devices      Device[]
  attempts     QuizAttempt[]
  orders       Order[]
  quizAccess   QuizAccess[]
  bookmarks    Bookmark[]
  savedQuizzes SavedQuiz[]
  badges       UserBadge[]
  syncRecords  OfflineSync[]
  leaderboard  LeaderboardEntry[]

  @@index([role, isActive])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid()) @db.VarChar(30)
  tokenHash String   @unique @db.VarChar(255)
  userId    String   @db.VarChar(30)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Device {
  id         String   @id @default(cuid()) @db.VarChar(30)
  userId     String   @db.VarChar(30)
  deviceKey  String   @db.VarChar(191)
  platform   String   @db.VarChar(30)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceKey])
  @@index([userId])
}

model Category {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @db.VarChar(191)
  slug      String   @unique @db.VarChar(191)
  exams     Exam[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id          String  @id @default(cuid()) @db.VarChar(30)
  categoryId  String  @db.VarChar(30)
  name        String  @db.VarChar(191)
  slug        String  @db.VarChar(191)
  description String? @db.Text

  category Category @relation(fields: [categoryId], references: [id])
  quizzes  Quiz[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Subject {
  id        String     @id @default(cuid()) @db.VarChar(30)
  name      String     @db.VarChar(191)
  slug      String     @unique @db.VarChar(191)
  topics    Topic[]
  questions Question[]
}

model Topic {
  id        String @id @default(cuid()) @db.VarChar(30)
  subjectId String @db.VarChar(30)
  name      String @db.VarChar(191)
  slug      String @db.VarChar(191)

  subject   Subject   @relation(fields: [subjectId], references: [id])
  questions Question[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

model Quiz {
  id               String     @id @default(cuid()) @db.VarChar(30)
  examId           String     @db.VarChar(30)
  title            String     @db.VarChar(191)
  slug             String     @db.VarChar(191)
  description      String?    @db.Text
  status           QuizStatus @default(DRAFT)
  price            Int        @default(0)
  currency         String     @default("BDT") @db.VarChar(3)
  durationSeconds  Int?
  passPercentage   Float?
  shuffleQuestions Boolean    @default(false)
  shuffleOptions   Boolean    @default(false)
  negativeMark     Float      @default(0)
  maxAttempts      Int?
  publishedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  exam        Exam               @relation(fields: [examId], references: [id])
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  orders      Order[]
  access      QuizAccess[]
  savedBy     SavedQuiz[]
  leaderboard LeaderboardEntry[]

  @@unique([examId, slug])
  @@index([examId, status])
  @@index([status, publishedAt])
}

model Question {
  id          String   @id @default(cuid()) @db.VarChar(30)
  subjectId   String   @db.VarChar(30)
  topicId     String?  @db.VarChar(30)
  body        String   @db.Text
  explanation String?  @db.Text
  difficulty  Int      @default(1)
  marks       Float    @default(1)
  imageUrl    String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject        @relation(fields: [subjectId], references: [id])
  topic     Topic?         @relation(fields: [topicId], references: [id])
  options   Option[]
  quizzes   QuizQuestion[]
  answers   AttemptAnswer[]
  bookmarks Bookmark[]

  @@index([subjectId, topicId])
  @@index([isActive])
}

model Option {
  id         String  @id @default(cuid()) @db.VarChar(30)
  questionId String  @db.VarChar(30)
  text       String  @db.Text
  imageUrl   String? @db.VarChar(500)
  isCorrect  Boolean @default(false)
  position   Int

  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswers AttemptAnswer[] @relation("SelectedOption")

  @@unique([questionId, position])
  @@index([questionId])
}

model QuizQuestion {
  quizId     String @db.VarChar(30)
  questionId String @db.VarChar(30)
  position   Int
  marks      Float?

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([quizId, questionId])
  @@unique([quizId, position])
  @@index([questionId])
}

model QuizAttempt {
  id               String        @id @default(cuid()) @db.VarChar(30)
  userId           String        @db.VarChar(30)
  quizId           String        @db.VarChar(30)
  status           AttemptStatus @default(IN_PROGRESS)
  requestId        String?       @unique @db.VarChar(191)
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  expiresAt        DateTime?
  totalQuestions   Int
  correctCount     Int           @default(0)
  wrongCount       Int           @default(0)
  unansweredCount  Int           @default(0)
  score            Float         @default(0)
  maxScore         Float         @default(0)
  percentage       Float         @default(0)
  timeTakenSeconds Int?

  user    User            @relation(fields: [userId], references: [id])
  quiz    Quiz            @relation(fields: [quizId], references: [id])
  answers AttemptAnswer[]

  @@index([userId, startedAt])
  @@index([quizId, status, submittedAt])
  @@index([userId, quizId, status])
}

model AttemptAnswer {
  id                String   @id @default(cuid()) @db.VarChar(30)
  attemptId         String   @db.VarChar(30)
  questionId        String   @db.VarChar(30)
  selectedOptionId  String?  @db.VarChar(30)
  isCorrect         Boolean?
  marksAwarded      Float    @default(0)
  timeTakenSeconds  Int?
  answeredAt        DateTime @default(now())

  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id])
  selectedOption Option?     @relation("SelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId, isCorrect])
  @@index([questionId])
}

model Order {
  id             String      @id @default(cuid()) @db.VarChar(30)
  userId         String      @db.VarChar(30)
  quizId         String      @db.VarChar(30)
  amount         Int
  currency       String      @default("BDT") @db.VarChar(3)
  status         OrderStatus @default(PENDING)
  idempotencyKey String?     @unique @db.VarChar(191)
  createdAt      DateTime    @default(now())
  paidAt         DateTime?

  user         User         @relation(fields: [userId], references: [id])
  quiz         Quiz         @relation(fields: [quizId], references: [id])
  payments     Payment[]
  accessGrants QuizAccess[]

  @@index([userId, createdAt])
  @@index([quizId, status])
}

model Payment {
  id                String        @id @default(cuid()) @db.VarChar(30)
  orderId           String        @db.VarChar(30)
  provider          String        @db.VarChar(50)
  providerReference String?       @db.VarChar(191)
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          String        @default("BDT") @db.VarChar(3)
  createdAt         DateTime      @default(now())
  paidAt            DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, providerReference])
  @@index([orderId, status])
}

model QuizAccess {
  id        String    @id @default(cuid()) @db.VarChar(30)
  userId    String    @db.VarChar(30)
  quizId    String    @db.VarChar(30)
  orderId   String?   @db.VarChar(30)
  grantedAt DateTime  @default(now())
  expiresAt DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz  Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id])

  @@unique([userId, quizId])
  @@index([userId, expiresAt])
}

model Bookmark {
  userId     String   @db.VarChar(30)
  questionId String   @db.VarChar(30)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([questionId])
}

model SavedQuiz {
  userId    String   @db.VarChar(30)
  quizId    String   @db.VarChar(30)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([userId, quizId])
  @@index([quizId])
}

model Badge {
  id          String  @id @default(cuid()) @db.VarChar(30)
  name        String  @unique @db.VarChar(191)
  description String? @db.Text
  imageUrl    String? @db.VarChar(500)

  userBadges UserBadge[]
}

model UserBadge {
  userId   String   @db.VarChar(30)
  badgeId  String   @db.VarChar(30)
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@id([userId, badgeId])
  @@index([badgeId])
}

model LeaderboardEntry {
  id             String    @id @default(cuid()) @db.VarChar(30)
  userId         String    @db.VarChar(30)
  quizId         String    @db.VarChar(30)
  bestScore      Float     @default(0)
  bestPercentage Float     @default(0)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([quizId, bestScore])
}

model OfflineSync {
  id          String    @id @default(cuid()) @db.VarChar(30)
  userId      String    @db.VarChar(30)
  syncKey     String    @db.VarChar(191)
  status      String    @default("PENDING") @db.VarChar(30)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, syncKey])
  @@index([userId, status])
}
