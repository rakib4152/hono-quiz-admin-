# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Endpoint for Hono / Cloudflare Workers API backend
# e.g., http://localhost:8787/api/v1 (local Wrangler) or https://api.yourdomain.com/api/v1
VITE_API_BASE_URL="http://localhost:8787/api/v1"

# DATABASE_URL: Direct MySQL connection string for local/dev use.
# Example format: mysql://user:password@host:port/database
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE: Local MySQL connection
# string used by Wrangler for the HYPERDRIVE binding during `wrangler dev`.
# Example format: mysql://user:password@host:port/database
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="mysql://USER:PASSWORD@HOST:PORT/DATABASE"