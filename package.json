{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "server.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:frontend": "vite --port=3002 --host=0.0.0.0",
    "dev:api": "wrangler dev --port 8787",
    "dev:api:apps": "wrangler dev --config apps/wrangler.jsonc --port 8787",
    "dev:all": "concurrently -k -n \"FE,API\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:api\"",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js && cp dist/index.js index.js && cp dist/index.js server.js && cp dist/index.js app.js && cp dist/index.js dist/server.js",
    "postinstall": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js && cp dist/index.js index.js && cp dist/index.js server.js && cp dist/index.js app.js && cp dist/index.js dist/server.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js && cp dist/index.js index.js && cp dist/index.js server.js && cp dist/index.js app.js && cp dist/index.js dist/server.js",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js index.js app.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.11",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.8",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "drizzle-seed": "^0.3.1",
    "express": "^4.21.2",
    "hono": "^4.13.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.89.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  }
}